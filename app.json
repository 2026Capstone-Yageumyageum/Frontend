{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3BC1A8"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "투구 영상을 업로드하기 위해 사진 라이브러리에 접근합니다.",
        "NSPhotoLibraryAddUsageDescription": "촬영한 투구 영상을 갤러리에 저장하기 위해 사진 라이브러리에 접근합니다."
      }
    },
    "android": {
      "package": "com.fitch.frontend",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "526314a1-d798-4ebf-99a6-a737edb39530"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          // expo-image-picker에서 cameraPermission: false를 설정하면
          // tools:node="remove"가 AndroidManifest에 삽입되어
          // react-native-vision-camera의 카메라 권한까지 제거해버립니다.
          // 이미지 피커에서 카메라를 사용하지 않더라도 이 옵션은 제거합니다.
          "photosPermission": "투구 영상을 업로드하기 위해 사진 라이브러리에 접근합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "촬영한 투구 영상을 갤러리에 저장합니다.",
          "savePhotosPermission": "촬영한 투구 영상을 갤러리에 저장합니다.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3BC1A8"
        }
      ]
    ]
  }
}